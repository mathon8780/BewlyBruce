{
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "push": false
  },
  "hooks": {
    "before:init": [
      "pnpm run lint",
      "pnpm run typecheck",
      "pnpm run test"
    ],
    "after:bump": [
      "pnpm run build",
      "pnpm run build-firefox",
      "pnpm run pack:zip",
      "pnpm run pack:zip-firefox"
    ],
    "after:release": [
      "pnpm run pack:zip-firefox-sources"
    ]
  },
  "npm": {
    "publish": false
  }
}
